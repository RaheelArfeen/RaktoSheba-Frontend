# Base URL of the RaktoSheba backend, no trailing slash.
# Local: http://localhost:8000 · Production: https://raktosheba-backend.vercel.app
API_BASE_URL=http://localhost:8000

# Public URL of this site, used for SEO/Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: where the live notification socket runs (usually the same as API_BASE_URL).
# Leave it empty on Vercel — serverless functions can't hold sockets open, so the
# notification bell checks for new notifications every 20 seconds instead.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
